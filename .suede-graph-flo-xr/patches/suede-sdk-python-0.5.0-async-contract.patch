+    # ------------------------------------------------------------------ polling
+    def poll_song(
+        self,
+        poll_url: str,
+        *,
+        poll_interval: float | None = None,
+        poll_timeout: float | None = None,
+    ) -> dict[str, Any]:
+        """``GET /api/songs/{songId}`` until ``model_version`` leaves ``pending``.
+
+        Free and unauthenticated. Returns the song row; ``model_version`` is
+        ``failed`` for a terminal failure, otherwise a version label and
+        ``audio_url`` is the finished MP3. An unknown ``songId`` raises
+        :class:`httpx.HTTPStatusError` (404).
