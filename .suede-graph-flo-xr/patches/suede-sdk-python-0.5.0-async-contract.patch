+        return self._poll(
+            poll_url,
+            done=lambda row: (
+                isinstance(row.get("model_version"), str) and row["model_version"] != "pending"
+            ),
+            status_of=lambda row: row.get("model_version"),
+            poll_interval=poll_interval,
+            poll_timeout=poll_timeout,
+        )
