+    def _job_result(
+        self,
+        result: dict[str, Any],
+        *,
+        wait: bool,
+        poll_interval: float | None,
+        poll_timeout: float | None,
+    ) -> dict[str, Any]:
+        poll_url = result.get("pollUrl")
+        if (
+            not wait
+            or not isinstance(poll_url, str)
+            or not poll_url
+            or result.get("status") in _TERMINAL_JOB_STATUSES
+        ):
+            return result
+        return self.poll_job(poll_url, poll_interval=poll_interval, poll_timeout=poll_timeout)
 
