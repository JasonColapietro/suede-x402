+    def poll_job(
+        self,
+        poll_url: str,
+        *,
+        poll_interval: float | None = None,
+        poll_timeout: float | None = None,
+    ) -> dict[str, Any]:
+        """Poll a video or image job until ``status`` is ``completed`` or ``failed``.
+
+        Free and unauthenticated. Note that an unknown ``jobId`` answers
+        ``200`` with ``status: "failed"`` rather than 404, so keep the exact
+        ``pollUrl`` the paid response handed back.
+        """
+        return self._poll(
+            poll_url,
+            done=lambda job: job.get("status") in _TERMINAL_JOB_STATUSES,
+            status_of=lambda job: job.get("status"),
+            poll_interval=poll_interval,
+            poll_timeout=poll_timeout,
+        )
+
+    def _poll(
+        self,
+        url: str,
+        *,
+        done: Callable[[dict[str, Any]], bool],
+        status_of: Callable[[dict[str, Any]], Any],
+        poll_interval: float | None,
+        poll_timeout: float | None,
+    ) -> dict[str, Any]:
+        interval = self._poll_interval if poll_interval is None else poll_interval
+        timeout = self._poll_timeout if poll_timeout is None else poll_timeout
+        started = time.monotonic()
+        while True:
+            response = self._http.get(url)
+            response.raise_for_status()
+            body = _safe_json(response)
+            if done(body):
+                return body
+            if time.monotonic() - started + interval >= timeout:
+                status = status_of(body)
+                raise RenderTimeout(url, status if isinstance(status, str) else None, timeout)
+            self._sleep(interval)
+
